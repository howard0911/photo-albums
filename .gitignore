# Based on templates from https://github.com/github/gitignore
# (Node, Python, macOS, Windows, VisualStudioCode, JetBrains)

# ---- Environment / secrets ----
.env
.env.*
!.env.example

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnp.*
dist/
.cache/
.parcel-cache/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- Local tool logs (gstack browse) ----
.gstack/

# ---- OS ----
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Editors / IDEs ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*~

# ---- Logs / temp ----
*.log
*.tmp
